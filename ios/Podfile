platform :ios, '15.1'
require_relative '../node_modules/react-native/scripts/react_native_pods'

# Attempt to load the RN CLI native_modules from either possible package locations.
# Some workspaces use '@react-native-community/cli-platform-ios' while newer setups use
# '@react-native/cli-platform-ios'. If neither is present, fall back to a minimal
# config so `pod install` can still proceed (useful for repos that haven't added an
# Xcode ios/ project yet).
native_modules_loaded = false
['../node_modules/@react-native-community/cli-platform-ios/native_modules',
 '../node_modules/@react-native/cli-platform-ios/native_modules'].each do |path|
  begin
    require_relative path
    native_modules_loaded = true
    break
  rescue LoadError
    next
  end
end

unless native_modules_loaded
  def use_native_modules!
    return { reactNativePath: '../node_modules/react-native' }
  end
end

target 'BlinkBuddy' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath]
  )
 

  # Enables Flipper if available. If the helper is not defined, skip it.
  begin
    use_flipper!
  rescue NoMethodError
    puts 'use_flipper! helper not available; skipping Flipper setup.'
  end

  post_install do |installer|
    react_native_post_install(installer)
    __apply_Xcode_12_5_M1_post_install_workaround(installer)
  end
end
