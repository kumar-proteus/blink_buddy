# Disable codegen and new architecture
ENV['DISABLE_CODEGEN'] = '1'
ENV['RCT_NEW_ARCH_ENABLED'] = '0'
ENV['USE_HERMES'] = '0'
ENV['NO_FLIPPER'] = '1'

platform :macos, '11.0'

# Create dummy ReactCodegen podspec before anything else
codegen_path = File.join(__dir__, '..', 'build', 'generated', 'ios')
FileUtils.mkdir_p(codegen_path)
File.write(File.join(codegen_path, 'ReactCodegen.podspec'), <<~'PODSPEC')
Pod::Spec.new do |s|
  s.name         = "ReactCodegen"
  s.version      = "0.0.1"
  s.summary      = "Dummy spec for macOS build"
  s.homepage     = "https://reactnative.dev"
  s.license      = "MIT"
  s.author       = "Meta"
  s.platforms    = { :osx => "11.0" }
  s.source       = { :git => "", :tag => "0.0.1" }
  s.source_files = "dummy.h"
end
PODSPEC
File.write(File.join(codegen_path, 'dummy.h'), "// Dummy file\n")

# Skip prepare_react_native_project!
def prepare_react_native_project!
  # no-op
end

# Try to load native modules, fallback if not available
begin
  require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'
rescue LoadError
  begin
    require_relative '../node_modules/@react-native/cli-platform-ios/native_modules'
  rescue LoadError
    def use_native_modules!
      { reactNativePath: '../node_modules/react-native-macos' }
    end
  end
end

target 'BlinkBuddy-macOS' do
  config = use_native_modules!
  rn_path = '../node_modules/react-native-macos'

  # Core React Native pods
  pod 'FBLazyVector', :path => "#{rn_path}/Libraries/FBLazyVector"
  pod 'RCT-Folly', :podspec => "#{rn_path}/third-party-podspecs/RCT-Folly.podspec"
  pod 'RCTTypeSafety', :path => "#{rn_path}/Libraries/TypeSafety"
  pod 'React-Core', :path => "#{rn_path}/"
  pod 'React-CoreModules', :path => "#{rn_path}/React/CoreModules"
  pod 'React-RCTActionSheet', :path => "#{rn_path}/Libraries/ActionSheetIOS"
  pod 'React-RCTAnimation', :path => "#{rn_path}/Libraries/NativeAnimation"
  pod 'React-RCTBlob', :path => "#{rn_path}/Libraries/Blob"
  pod 'React-RCTImage', :path => "#{rn_path}/Libraries/Image"
  pod 'React-RCTLinking', :path => "#{rn_path}/Libraries/LinkingIOS"
  pod 'React-RCTNetwork', :path => "#{rn_path}/Libraries/Network"
  pod 'React-RCTSettings', :path => "#{rn_path}/Libraries/Settings"
  pod 'React-RCTText', :path => "#{rn_path}/Libraries/Text"
  pod 'React-RCTVibration', :path => "#{rn_path}/Libraries/Vibration"
  pod 'React-cxxreact', :path => "#{rn_path}/ReactCommon/cxxreact"
  pod 'React-jsi', :path => "#{rn_path}/ReactCommon/jsi"
  pod 'React-jsiexecutor', :path => "#{rn_path}/ReactCommon/jsiexecutor"
  pod 'React-callinvoker', :path => "#{rn_path}/ReactCommon/callinvoker"
  pod 'React-runtimeexecutor', :path => "#{rn_path}/ReactCommon/runtimeexecutor"
  pod 'React-perflogger', :path => "#{rn_path}/ReactCommon/reactperflogger"
  pod 'React-logger', :path => "#{rn_path}/ReactCommon/logger"
  pod 'ReactCommon/turbomodule/core', :path => "#{rn_path}/ReactCommon"
  pod 'Yoga', :path => "#{rn_path}/ReactCommon/yoga"
  pod 'DoubleConversion', :podspec => "#{rn_path}/third-party-podspecs/DoubleConversion.podspec"
  pod 'glog', :podspec => "#{rn_path}/third-party-podspecs/glog.podspec"
  pod 'boost', :podspec => "#{rn_path}/third-party-podspecs/boost.podspec"

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'
      end
    end
  end
end
