# Disable new architecture to avoid codegen issues with react-native-macos 0.76
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :macos, '11.0'

# Attempt to load react_native_pods from react-native-macos
begin
  require Pod::Executable.execute_command('node', ['-p',
    'require.resolve(
      "react-native-macos/scripts/react_native_pods.rb",
      {paths: [process.argv[1]]},
    )', __dir__]).strip
rescue => e
  Pod::UI.warn "Could not load react_native_pods.rb: #{e.message}"
end

# Attempt to load native_modules from either possible package locations
native_modules_loaded = false
['../node_modules/@react-native-community/cli-platform-ios/native_modules',
 '../node_modules/@react-native/cli-platform-ios/native_modules'].each do |path|
  begin
    require_relative path
    native_modules_loaded = true
    break
  rescue LoadError
    next
  end
end

unless native_modules_loaded
  def use_native_modules!
    return { reactNativePath: '../node_modules/react-native-macos' }
  end
end

# Create dummy ReactCodegen podspec if it doesn't exist (workaround for version mismatch)
codegen_path = File.join(__dir__, '..', 'build', 'generated', 'ios')
codegen_podspec = File.join(codegen_path, 'ReactCodegen.podspec')
unless File.exist?(codegen_podspec)
  FileUtils.mkdir_p(codegen_path)
  File.write(codegen_podspec, <<-PODSPEC)
Pod::Spec.new do |s|
  s.name         = "ReactCodegen"
  s.version      = "0.0.1"
  s.summary      = "Dummy spec for macOS build"
  s.homepage     = "https://reactnative.dev"
  s.license      = "MIT"
  s.author       = "Meta"
  s.platforms    = { :osx => "11.0" }
  s.source       = { :git => "", :tag => "\#{s.version}" }
  s.source_files = "dummy.h"
end
  PODSPEC
  File.write(File.join(codegen_path, 'dummy.h'), "// Dummy file for ReactCodegen\n")
end

target 'BlinkBuddy-macOS' do
  config = use_native_modules!

  use_react_native!(
    :path => "../node_modules/react-native-macos",
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Apply standard post-install fixes
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'
      end
    end

    # Call react_native_post_install if available
    if defined?(react_native_post_install)
      react_native_post_install(
        installer,
        "../node_modules/react-native-macos",
        :mac_catalyst_enabled => false
      )
    end
  end
end
